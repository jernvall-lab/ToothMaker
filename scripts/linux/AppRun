#!/bin/sh
# AppImage entry point. The bundled libraries are exported so that the model
# binaries, which ToothMaker copies to a temp directory and runs, find them too.
HERE="$(dirname "$(readlink -f "$0")")"
export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$HERE/usr/bin/ToothMaker" "$@"
